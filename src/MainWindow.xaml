            </DockPanel>
          </StackPanel>
          <StackPanel x:Name="Mo2Paths" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock x:Name="Mo2Label" Text="MO2 instance configuration" Margin="0,0,0,5"/>
            <DockPanel Margin="0,0,0,6">
              <Button x:Name="BrowseMo2" DockPanel.Dock="Right" Content="Browse" Margin="7,0,0,0"/>
              <TextBox x:Name="Mo2Ini" MinWidth="570"/>
            </DockPanel>
            <TextBlock x:Name="Mo2Hint" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
          </StackPanel>
          <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="LanguageLabel" Text="Language" Width="130"/>
            <ComboBox x:Name="Language" Width="190" HorizontalAlignment="Left" SelectedIndex="0">
              <ComboBoxItem Content="English"/><ComboBoxItem Content="Italiano"/>
            </ComboBox>
          </DockPanel>
          <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="BadgeEditionLabel" Text="Edition badge" Width="130"/>
            <ComboBox x:Name="BadgeEdition" Width="190" HorizontalAlignment="Left"/>
          </DockPanel>
          <CheckBox x:Name="AutoScan" Content="Scan at startup" IsChecked="True" Margin="0,0,0,8"/>
          <CheckBox x:Name="FemaleOnly" Content="Prefer female and shared equipment" IsChecked="True" Margin="0,0,0,12"/>
          <Button x:Name="Scan" Content="Scan library" HorizontalAlignment="Left" Style="{StaticResource Accent}"/>
          <TextBlock x:Name="PreviewSettingsHeading" Text="Live preview" Style="{StaticResource Heading}" Margin="0,18,0,8"/>
          <CheckBox x:Name="TexturedPreview" Content="Use original textures in the 3D preview" Margin="0,0,0,5"/>
          <TextBlock x:Name="TexturedPreviewHint" Text="Turn off textures to see each part in a distinct color." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
          <TextBlock x:Name="AudioSettingsHeading" Text="Audio" Style="{StaticResource Heading}" Margin="0,18,0,8"/>
          <CheckBox x:Name="MusicEnabled" Content="Play background music" Margin="0,0,0,5"/>
          <DockPanel Margin="0,0,0,10" LastChildFill="False">
            <Button x:Name="BrowseMusic" Content="Choose music" Margin="0,0,8,0"/>
            <TextBlock x:Name="MusicSelection" MaxWidth="390" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <CheckBox x:Name="EffectsEnabled" Content="Play interface sounds" Margin="0,0,0,5"/>
          <DockPanel Margin="0,0,0,6" LastChildFill="False">
            <Button x:Name="BrowseCrash" Content="Choose error sound" Margin="0,0,8,0"/>
            <TextBlock x:Name="CrashSelection" MaxWidth="390" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <DockPanel Margin="0,0,0,6" LastChildFill="False">
            <Button x:Name="BrowseExportSound" Content="Choose export sound" Margin="0,0,8,0"/>
            <TextBlock x:Name="ExportSoundSelection" MaxWidth="390" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <Button x:Name="ResetAudio" Content="Use default audio files" HorizontalAlignment="Left"/>
        </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="GuidePage" Style="{StaticResource Panel}" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel HorizontalAlignment="Left" MaxWidth="800">
            <TextBlock x:Name="GuideHeading" Text="Guide" Style="{StaticResource Heading}" Margin="0,0,0,12"/>
            <TextBlock x:Name="GuideText" TextWrapping="Wrap" LineHeight="23"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,8,0,0">
      <Button x:Name="Notices" DockPanel.Dock="Right" Content="Scan details" MinHeight="24" Padding="8,2"/>
      <TextBlock x:Name="Status" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
    </DockPanel>
  </Grid>
</Window>
