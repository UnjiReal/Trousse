<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trousse" Width="1320" Height="900" MinWidth="1000" MinHeight="710"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#090A0B" Foreground="#ECE9E2"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#463C30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#362F27"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="#BFB6A8"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#ECE9E2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent" LastChildFill="True">
              <Border x:Name="CheckFrame" DockPanel.Dock="Left" Width="15" Height="15" Margin="0,0,6,0"
                      Background="#111214" BorderBrush="#8A7153" BorderThickness="1" CornerRadius="2">
                <Path x:Name="CheckMark" Stroke="#E0BA87" StrokeThickness="1.7" Data="M 2,6 L 5,9 L 10,3" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckFrame" Property="BorderBrush" Value="#E0BA87"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFrame" Property="BorderBrush" Value="#E0BA87"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#111214"/>
      <Setter Property="Foreground" Value="#F1F4F7"/>
      <Setter Property="CaretBrush" Value="#F1F4F7"/>
      <Setter Property="BorderBrush" Value="#5A4A37"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Background" Value="#262321"/>
      <Setter Property="BorderBrush" Value="#66533B"/>
      <Setter Property="Foreground" Value="#F5F1E9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C6A475"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E0BA87"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.76"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.46"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#D9D4C9"/>
      <Setter Property="BorderBrush" Value="#D9D4C9"/>
      <Setter Property="Foreground" Value="#151210"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Background" Value="#111214"/>
      <Setter Property="Foreground" Value="#ECE9E2"/>
      <Setter Property="BorderBrush" Value="#5A4A37"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                      <Path Data="M0,0 L8,0 L4,4 Z" Fill="#BFB6A8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#C6A475"/></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#C6A475"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="9,0,23,0" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=DropDownToggle}"
                     IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" AllowsTransparency="True">
                <Border Background="#1C1B19" BorderBrush="#5A4A37" BorderThickness="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DropDownToggle" Property="BorderBrush" Value="#C6A475"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#ECE9E2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Row" Background="Transparent" Padding="8,5"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#362F27"/></Trigger>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#463C30"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="#191715"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}" Padding="3,2">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="PageBack" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                      <Border x:Name="Grip" Background="#665541" CornerRadius="3"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#A48763"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Grip" Property="Background" Value="#473B2E"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="PageForward" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter TargetName="PageBack" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                <Setter TargetName="PageForward" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#111214"/>
      <Setter Property="Foreground" Value="#ECE9E2"/>
      <Setter Property="BorderBrush" Value="#554838"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ScrollViewer" Padding="{TemplateBinding Padding}" Focusable="False"
                            CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="#ECE9E2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#302820"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#362F27"/>
                <Setter TargetName="Row" Property="BorderBrush" Value="#9C7950"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="Selector.IsSelectionActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Row" Property="Background" Value="#463C30"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#B6C4D1"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Border" x:Key="Panel">
      <Setter Property="Background" Value="#1C1B19"/>
      <Setter Property="BorderBrush" Value="#574936"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <DataTemplate x:Key="OarFlagEditor">
      <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" VerticalAlignment="Center"
                AutomationProperties.Name="{Binding Label}" HorizontalAlignment="Left"/>
    </DataTemplate>
    <DataTemplate x:Key="OarChoiceEditor">
      <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                SelectedValue="{Binding Value, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}"/>
    </DataTemplate>
    <DataTemplate x:Key="OarTextEditor">
      <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"/>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="22,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="HomeNav" Content="Compose" Margin="0,0,6,0"/>
        <Button x:Name="CurrentNav" Content="Installed outfit" Margin="0,0,6,0"/>
        <Button x:Name="BodiesNav" Content="Bodies" Margin="0,0,6,0"/>
        <Button x:Name="PackNav" Content="Package" Margin="0,0,6,0"/>
        <Button x:Name="KidNav" Content="KID" Margin="0,0,6,0"/>
        <Button x:Name="OarNav" Content="OAR" Margin="0,0,6,0"/>
        <Button x:Name="PosesNav" Content="Poses" Margin="0,0,6,0"/>
        <Button x:Name="DressNav" Content="Dress Up Lovers" Margin="0,0,6,0"/>
        <Button x:Name="SettingsNav" Content="Settings" Margin="0,0,6,0"/>
        <Button x:Name="GuideNav" Content="Guide"/>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
        <Image x:Name="BrandIcon" Width="43" Height="43" Margin="0,0,10,0"/>
        <TextBlock Text="Trousse" FontFamily="Georgia" FontSize="34" FontWeight="SemiBold"/>
        <Image x:Name="StoreBadge" Width="29" Height="29" Margin="18,0,7,0" Visibility="Collapsed"/>
        <Image x:Name="SkyrimBadge" Height="30" MaxWidth="104" Margin="2,0,0,0" Stretch="Uniform" Visibility="Collapsed"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid x:Name="HomePage">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.28*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="1.47*"/><RowDefinition Height="12"/><RowDefinition Height="1*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Panel}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="LibraryHeading" Text="BodySlide library" Style="{StaticResource Heading}"/>
              <DockPanel Grid.Row="1" Margin="0,7,0,7">
                <TextBlock x:Name="PieceCount" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Muted}"/>
                <TextBlock x:Name="PieceSearchLabel" Text="Search mods or parts" Margin="0,0,8,0" Style="{StaticResource Muted}"/>
                <TextBox x:Name="PieceSearch"/>
              </DockPanel>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions>
                <ListBox x:Name="ModList" AutomationProperties.Name="Mods">
                  <ListBox.ItemTemplate><DataTemplate>
                    <DockPanel ToolTip="{Binding Name}">
                      <Button DockPanel.Dock="Right" Content="{Binding Badge}" ToolTip="{Binding BadgeHint}" MinHeight="23" Padding="6,1"
                              Margin="6,0,0,0" Foreground="{Binding BadgeColor}" Command="{Binding OpenSource}"/>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <ListBox x:Name="SourceList" Grid.Column="2" SelectionMode="Extended" AutomationProperties.Name="BodySlide parts">
                  <ListBox.ItemTemplate><DataTemplate>
                    <TextBlock Text="{Binding ShortName}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
              <DockPanel Grid.Row="3" Margin="0,7,0,0" LastChildFill="False">
                <Button x:Name="InspectPiece" Content="Inspect part" Margin="0,0,6,0"/>
                <Button x:Name="AddPieces" DockPanel.Dock="Right" Content="Add selected parts" Style="{StaticResource Accent}"/>
                <Button x:Name="DressComposePart" DockPanel.Dock="Right" Content="Use in Dress Up" Margin="0,0,6,0"/>
              </DockPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource Panel}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="VanillaHeading" Text="Game equipment" Style="{StaticResource Heading}"/>
              <DockPanel Grid.Row="1" Margin="0,7,0,6">
                <TextBlock x:Name="TargetCount" DockPanel.Dock="Right" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                <ComboBox x:Name="TargetCategory" DockPanel.Dock="Right" MinWidth="148" Margin="7,0,0,0" AutomationProperties.Name="Equipment category"/>
                <TextBlock x:Name="TargetSearchLabel" Text="Search base game and DLC" Margin="0,0,8,0" Style="{StaticResource Muted}"/>
                <TextBox x:Name="TargetSearch"/>
              </DockPanel>
              <ListBox x:Name="TargetList" Grid.Row="2" AutomationProperties.Name="Vanilla equipment">
                <ListBox.ItemTemplate><DataTemplate>
                  <DockPanel ToolTip="{Binding Mesh}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding View}" FontSize="11" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ShortIds}" ToolTip="{Binding ConsoleIds}"
                               FontSize="11" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <DockPanel Grid.Row="3" Margin="0,6,0,0">
                <Button x:Name="Variants" DockPanel.Dock="Right" Content="Variants and modesty"/>
                <Button x:Name="DressComposeTarget" DockPanel.Dock="Right" Content="Use in Dress Up" Margin="0,0,6,0"/>
                <TextBlock x:Name="TargetInfo" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
              </DockPanel>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions><RowDefinition Height="1.15*"/><RowDefinition Height="12"/><RowDefinition Height="1*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Panel}" Padding="13">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel>
                <Button x:Name="ShowOutfitView" DockPanel.Dock="Right" Content="Show outfit"/>
                <TextBlock x:Name="PreviewHeading" Text="Live preview" Style="{StaticResource Heading}"/>
              </DockPanel>
              <Border x:Name="PreviewSurface" Grid.Row="1" Margin="0,8,0,7" Background="#111214" BorderBrush="#514434" BorderThickness="1" CornerRadius="4">
                <Grid Background="Transparent">
                  <Viewport3D x:Name="Viewport" ClipToBounds="True" IsHitTestVisible="False"/>
                  <TextBlock x:Name="LiveHint" Text="Add parts to see the outfit" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Style="{StaticResource Muted}" IsHitTestVisible="False"/>
                </Grid>
              </Border>
              <DockPanel Grid.Row="2">
                <Button x:Name="Preview" Content="Open in BodySlide" DockPanel.Dock="Right"/>
                <TextBlock x:Name="ViewControls" Text="Drag to rotate · scroll to zoom" Style="{StaticResource Muted}"/>
              </DockPanel>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Panel}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,7">
                <Button x:Name="NewOutfit" Content="New outfit" DockPanel.Dock="Right"/>
                <TextBlock x:Name="ComposeHeading" Text="Compose outfit" Style="{StaticResource Heading}"/>
              </DockPanel>
              <DockPanel Grid.Row="1" Margin="0,0,0,6">
                <TextBlock x:Name="OutfitNameLabel" Text="Outfit name" Width="105" Style="{StaticResource Muted}"/>
                <TextBox x:Name="OutfitName" MaxLength="100" AutomationProperties.Name="Outfit name"/>
              </DockPanel>
              <DockPanel Grid.Row="2" Margin="0,0,0,7">
                <TextBlock x:Name="MeshLabel" Text="Destination" Width="105" Style="{StaticResource Muted}"/>
                <TextBlock x:Name="MeshPath" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Border x:Name="ComposeConflict" Grid.Row="3" Background="#412326" BorderBrush="#E56865" BorderThickness="3,0,0,0"
                      Padding="8,5" Margin="0,0,0,7" Visibility="Collapsed">
                <TextBlock x:Name="ComposeConflictMessage" Foreground="#FFD1CF" TextWrapping="Wrap" MaxHeight="52"/>
              </Border>
              <ListBox x:Name="DraftList" Grid.Row="4" AutomationProperties.Name="Selected parts">
                <ListBox.ItemTemplate><DataTemplate>
                  <Border x:Name="PartConflict" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="5,2">
                    <StackPanel>
                      <TextBlock x:Name="PartName" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Detail}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasBuildError}" Value="True">
                      <Setter TargetName="PartName" Property="Foreground" Value="#FFD1CF"/>
                      <Setter TargetName="PartConflict" Property="Background" Value="#592B2D"/>
                      <Setter TargetName="PartConflict" Property="BorderBrush" Value="#E56865"/>
                      <Setter TargetName="PartConflict" Property="ToolTip" Value="{Binding BuildError}"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <DockPanel Grid.Row="5" Margin="0,7,0,0" LastChildFill="False">
                <Button x:Name="Up" Content="↑" AutomationProperties.Name="Move part up" Margin="0,0,4,0"/>
                <Button x:Name="Down" Content="↓" AutomationProperties.Name="Move part down" Margin="0,0,4,0"/>
                <Button x:Name="RemovePiece" Content="Remove part"/>
                <Button x:Name="Commit" DockPanel.Dock="Right" Content="Add to package" Style="{StaticResource Accent}"/>
              </DockPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Border x:Name="PackPage" Style="{StaticResource Panel}" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button x:Name="OpenPack" Content="Open project" Margin="0,0,6,0"/>
              <Button x:Name="SavePack" Content="Save project"/>
            </StackPanel>
            <TextBlock x:Name="PackageHeading" Text="Replacer package" Style="{StaticResource Heading}"/>
          </DockPanel>
          <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="PackNameLabel" Text="Package name" Margin="0,0,10,0" Style="{StaticResource Muted}"/>
            <TextBox x:Name="PackName" Text="My replacers" MaxLength="72"/>
          </DockPanel>
          <ListBox x:Name="PackList" Grid.Row="2" AutomationProperties.Name="Outfits in package">
            <ListBox.ItemTemplate><DataTemplate>
              <StackPanel ToolTip="{Binding Mesh}">
                <TextBlock x:Name="PackageOutfitName" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Mesh}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasBuildError}" Value="True">
                  <Setter TargetName="PackageOutfitName" Property="Foreground" Value="#FF9E9A"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
